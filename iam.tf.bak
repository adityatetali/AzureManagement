module "iam" {
  source                = "app.terraform.io/adityatetaliorg/iam/azure"
  version               = "0.1.10"
  create_resource_group = true
  resource_group_name   = "rg-iam-test"
  location              = "Central US"

  managed_identities = {
    "app-identity" = {
      tags = {
        Environment  = "Production"
        Application  = "WebApp"
        Project_code = "PRJ001"
        Agency       = "ExampleAgency"
        Owner        = "team@example.com"
      }
    }
  }

  custom_roles = {
    "custom-reader" = {
      description = "Custom read-only role for specific resources"
      actions = [
        "Microsoft.Storage/storageAccounts/blobServices/containers/read",
        "Microsoft.Storage/storageAccounts/blobServices/read"
      ]
    }
  }

  role_assignments = {
    "storage-reader" = {
      scope          = "/subscriptions/38fe3474-4d82-4029-a49f-ba81a9ab017b/resourceGroups/rg-iam-prod"
      custom_role    = true
      role_name      = "custom-reader"
      principal_id   = "9e9ef130-b8b7-47ee-bfc5-9a6b19383a23"
      principal_type = "User"
    }
  }

  tags = {
    Application  = "WebApp"
    Agency       = "ExampleAgency"
    Project_code = "PRJ001"
    Environment  = "Production"
    Owner        = "team@example.com"
  }
}
